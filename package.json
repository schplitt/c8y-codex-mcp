{
  "name": "c8y-codex-mcp",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "description": "MCP mirror of the official Cumulocity Codex documentation",
  "scripts": {
    "build": "wrangler build",
    "dev": "wrangler dev",
    "preview": "wrangler dev --remote",
