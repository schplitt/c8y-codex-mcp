    "@kreuzberg/html-to-markdown-wasm": "^2.30.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.13.1",
    "h3": "2.0.1-rc.21",
    "markdown-exit": "1.0.0-beta.8",
    "minisearch": "^7.2.0",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@schplitt/eslint-config": "^1.5.1",
    "@types/node": "^24.10.13",
    "eslint": "^10.4.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  }
